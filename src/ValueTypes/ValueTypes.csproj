<Project>

	<Sdk Name="Microsoft.NET.Sdk" />

	<PropertyGroup>
		<IsPackable>true</IsPackable>
		<PackageId>MSL.$(AssemblyName)</PackageId>
		<Title>ValueTypes — parse-don't-validate wrappers for the primitives your domain cares about</Title>
		<Authors>Mark Lauter</Authors>
		<Description>Contracts for strongly-typed wrappers that embed a primitive in the domain. IValue&lt;TSelf, TValue&gt; is self-referential (CRTP) so its static abstract members resolve through the type parameter at every call site: two arrows in — the fallible lift Parse (string to Result&lt;TSelf&gt;) and the unchecked embedding for values the caller vouches for — and one arrow out, the projection back to the primitive. Validation lives in Parse and only there, so a lifted value is trusted everywhere downstream. ITryParse opts a type into the BCL bool-plus-out shape for ASP.NET model binding, without putting transport concerns in the domain contract.</Description>
		<Copyright>Copyright (c) 2026 Mark Lauter</Copyright>
		<PackageProjectUrl>https://github.com/marklauter/value-type</PackageProjectUrl>
		<RepositoryUrl>https://github.com/marklauter/value-type</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>value-object;value-type;primitive-obsession;parse-dont-validate;strongly-typed;wrapper;domain-modeling;ddd;functional;result;validation;dotnet;msl-armory</PackageTags>
		<NeutralLanguage>en-US</NeutralLanguage>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageIcon>valuetypes-logo.small.png</PackageIcon>
	</PropertyGroup>

	<ItemGroup>
		<!-- The 128x128 variant is the packed icon; images/valuetypes-logo.png is the 256x256 the README embeds. -->
		<None Include="..\..\images\valuetypes-logo.small.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\..\README.md">
			<Pack>True</Pack>
			<PackagePath>README.md</PackagePath>
		</None>
		<None Include="..\..\LICENSE">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="MSL.Results" />
		<PackageReference Include="Microsoft.SourceLink.GitHub">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

</Project>
